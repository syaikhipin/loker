# career-ops-saas — copy to .env and fill in
# cp .env.example .env

# ── API ─────────────────────────────────────────────────────────────
PORT=3000

# ── Postgres (SaaS tables only: users, api_keys, jobs) ─────────────
# Free options: Neon (1GB/project) or Supabase (500MB). Use the pooled URL.
DATABASE_URL=postgresql://user:pass@host:5432/careerops

# ── S3-compatible object storage (user data dirs; 5GB is plenty) ────
# Works with AWS S3, idrive e2, MinIO. For MinIO set S3_FORCE_PATH_STYLE=true
# and S3_ENDPOINT=http://127.0.0.1:9000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=career-ops-saas
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── career-ops core checkout (scripts live here) ────────────────────
CAREER_OPS_HOME=/opt/career-ops

# ── Worker ──────────────────────────────────────────────────────────
POLL_INTERVAL_MS=2000
JOB_TIMEOUT_MS=600000
MAX_LOG_BYTES=131072

# ── LLM keys, forwarded to career-ops scripts (never logged) ───────
# The core already speaks OpenAI-compatible endpoints — no code changes.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
